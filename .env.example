# ==============================================================================
# AI Video Generator - Environment Variables & Secrets
# ==============================================================================

# 1. Google Gemini & AI Studio (Required for Script Breakdown & Brain Processing)
# Can be a single key or comma-separated list of keys for automatic rate-limit rotation
GOOGLE_AI_STUDIO_KEY=
GEMINI_API_KEY=

# 2. Google Workspace Service Account (Required for Google Doc & Sheet Integration)
# Paste the full raw JSON content of the Service Account or provide local file path
GOOGLE_SERVICE_JSON=

# Google Doc ID or URL containing the story/script to process
STORY_STORAGE_DOC=

# Google Sheet ID, Name, or URL used to track pipeline runs, model logs, and metrics
MODEL_STORAGE_SHEET=Model Storage Sheet

# 3. Hugging Face Tokens (Multi-Token Rotation)
# Comma-separated list of 6-7 Hugging Face user access tokens (hf_...)
HF_TOKENS=

# 4. Telegram Bot Integration (Character Asset Storage & Video Delivery)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
